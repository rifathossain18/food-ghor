# ==============================================================================
# Food Ghor (ফুড ঘর) — Environment Variables Example Template (.env.example)
# ==============================================================================

# Frontend Variables (Vite Client)
VITE_API_BASE_URL=
VITE_WHATSAPP_NUMBER=8801700000000
VITE_PHONE_DISPLAY="+৮৮০ ১৭০০-০০০০০০"
VITE_PHONE_RAW="+8801700000000"
VITE_CONTACT_EMAIL="info@foodghor.com"
VITE_CONTACT_ADDRESS="যশোর রোড, বনশ্রী, ঢাকা - ১২১৯"
VITE_TURNSTILE_SITE_KEY=""

# Backend / Hosting
APP_ENV=production
APP_URL=https://foodghor.com
APP_FRONTEND_ORIGIN=https://foodghor.com

# Database (MySQL 8.0)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=foodghor
DB_USER=foodghor_app
DB_PASS=__change_me__

# Security Secrets
SESSION_SECRET=__change_me_to_32_chars__
CSRF_SECRET=__change_me_to_32_chars__
SEED_ADMIN_PASSWORD=__change_me__
TURNSTILE_SECRET=""
